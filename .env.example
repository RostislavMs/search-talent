NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

NEXT_PUBLIC_APP_URL=

# Supabase service role key — required for admin-side operations such as
SUPABASE_SERVICE_ROLE_KEY=

# Resend email delivery — optional. If not set, email sending is skipped.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Search Talent <notifications@example.com>"

# GitHub OAuth App — required for the GitHub project auto-sync feature.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Google Gemini — required for AI-assisted features (e.g. drafting
# a project description from a GitHub repo, profile summaries).
#
# Use a key from a Cloud project linked to a billing account, i.e. the PAID
# tier. This is a privacy requirement, not a quota one: on the unpaid tier
# Google's terms allow using prompts and responses to improve its products,
# and the Privacy Policy states we are on the paid tier. Billing runs on
# prepaid credits with auto-reload off, so an empty balance makes AI calls
# fail (502, logged in `ai_usage`) rather than charging a card.
GEMINI_API_KEY=

# Cloudflare R2 — primary storage for project media, article images, and
# certificates. Avatars and profile covers still live in Supabase Storage.
# All five values are required for uploads to work.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Giphy — optional. Powers the GIF picker in comments. Without it the GIF
# button is hidden and comments stay text-only. Get a key at
# developers.giphy.com → Create App → API Key. The key stays server-side
# (the browser only calls our /api/gif/search proxy).
GIPHY_API_KEY=

# Leaderboard cron — optional but recommended. Protects the scheduled
# /api/cron/refresh-leaderboard endpoint that recomputes the leaderboard
# snapshot (see vercel.json crons). Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. If unset, the endpoint is unprotected
# and the leaderboard still self-heals lazily on read (up to a 15-min lag).
CRON_SECRET=